{
  "description": "Asks for ap-background in front of long background commands",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/ap-background-hook\""
          }
        ]
      }
    ]
  }
}
